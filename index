    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-12">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Artikel & Pembaruan Terbaru</h2>
          <p class="text-gray-600">Bagikan cerita, produk, atau informasi penting di bagian blog ini.</p>
        </div>
        <a href="#" class="text-red-600 hover:text-red-700 font-semibold flex items-center transition-colors">
          Lihat semua artikel <span class="ml-1">→</span>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Kartu 1 -->
        <div class="bg-gray-50 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all group">
          <div class="h-48 bg-gray-200 flex items-center justify-center text-gray-400 group-hover:bg-red-50 transition-colors">Placeholder Gambar 1</div>
          <div class="p-6">
            <span class="text-xs font-bold text-red-600 uppercase tracking-wider">Kategori A</span>
            <h3 class="text-lg font-bold text-gray-900 mt-2 mb-3 hover:text-red-600 transition-colors"><a href="#">Judul Artikel Utama Pertama Anda</a></h3>
            <p class="text-gray-600 text-sm line-clamp-3 mb-4">Ini adalah contoh ringkasan teks artikel yang bisa Anda isi dengan berita, deskripsi produk, atau pengumuman penting perusahaan.</p>
            <span class="text-xs text-gray-400">5 September 2026</span>
          </div>
        </div>
        <!-- Kartu 2 -->
        <div class="bg-gray-50 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all group">
          <div class="h-48 bg-gray-200 flex items-center justify-center text-gray-400 group-hover:bg-red-50 transition-colors">Placeholder Gambar 2</div>
          <div class="p-6">
            <span class="text-xs font-bold text-red-600 uppercase tracking-wider">Kategori B</span>
            <h3 class="text-lg font-bold text-gray-900 mt-2 mb-3 hover:text-red-600 transition-colors"><a href="#">Cara Mengubah Isi Website Ini</a></h3>
            <p class="text-gray-600 text-sm line-clamp-3 mb-4">Cukup buka file HTML ini menggunakan aplikasi teks editor seperti Notepad atau VS Code, lalu ganti teks di dalam tag HTML-nya.</p>
            <span class="text-xs text-gray-400">5 September 2026</span>
          </div>
        </div>
        <!-- Kartu 3 -->
        <div class="bg-gray-50 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all group">
          <div class="h-48 bg-gray-200 flex items-center justify-center text-gray-400 group-hover:bg-red-50 transition-colors">Placeholder Gambar 3</div>
          <div class="p-6 bg-gray-50 rounded-xl border border-gray-100 hover:shadow-md smooth-transition">
                        <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center font-bold text-xl mb-4">✍️</div>
                        <h3 class="text-xl font-semibold mb-2 text-gray-900">Mudah Diedit</h3>
                        <p class="text-gray-600 leading-relaxed">Struktur HTML yang rapi dengan penamaan kelas yang jelas, sangat mudah dipahami pemula.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CONTENT SECTION (Blog / Portofolio / Berita) -->
        <section id="konten" class="max-w-6xl mx-auto px-4 py-16">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-10 gap-4">
                <div>
                    <h2 class="text-3xl font-bold text-gray-900 mb-2">Artikel & Pembaruan Terbaru</h2>
                    <p class="text-gray-500">Bagikan cerita, produk, atau informasi penting di bagian blog ini.</p>
                </div>
                <a href="#" class="text-blue-600 hover:underline font-medium flex items-center gap-1 smooth-transition">
                    Lihat semua artikel →
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Konten Item 1 -->
                <article class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md smooth-transition flex flex-col">
                    <div class="bg-gray-200 h-48 w-full flex items-center justify-center text-gray-400 font-medium">Placeholder Gambar 1</div>
                    <div class="p-6 flex flex-col flex-grow">
                        <span class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-2">Kategori A</span>
                        <h3 class="text-xl font-bold text-gray-900 mb-2 hover:text-blue-600 smooth-transition">
                            <a href="#">Judul Artikel Utama Pertama Anda</a>
                        </h3>
                        <p class="text-gray-600 text-sm mb-4 line-clamp-3 leading-relaxed">
                            Ini adalah contoh ringkasan teks artikel yang bisa Anda isi dengan berita, deskripsi produk, atau pengumuman penting perusahaan.
                        </p>
                        <div class="mt-auto text-xs text-gray-400">5 September 2026</div>
                    </div>
                </article>

                <!-- Konten Item 2 -->
                <article class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md smooth-transition flex flex-col">
                    <div class="bg-gray-200 h-48 w-full flex items-center justify-center text-gray-400 font-medium">Placeholder Gambar 2</div>
                    <div class="p-6 flex flex-col flex-grow">
                        <span class="text-xs font-bold text-green-600 uppercase tracking-wider mb-2">Kategori B</span>
                        <h3 class="text-xl font-bold text-gray-900 mb-2 hover:text-blue-600 smooth-transition">
                            <a href="#">Cara Mengubah Isi Website Ini</a>
                        </h3>
                        <p class="text-gray-600 text-sm mb-4 line-clamp-3 leading-relaxed">
                            Cukup buka file HTML ini menggunakan aplikasi teks editor seperti Notepad atau VS Code, lalu ganti teks di dalam tag HTML-nya.
                        </p>
                        <div class="mt-auto text-xs text-gray-400">5 September 2026</div>
                    </div>
                </article>

                <!-- Konten Item 3 -->
                <article class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md smooth-transition flex flex-col">
                    <div class="bg-gray-200 h-48 w-full flex items-center justify-center text-gray-400 font-medium">Placeholder Gambar 3</div>
                    <div class="p-6 flex flex-col flex-grow">
                        <span class="text-xs font-bold text-purple-600 uppercase tracking-wider mb-2">Kategori C</span>
                        <h3 class="text-xl font-bold text-gray-900 mb-2 hover:text-blue-600 smooth-transition">
                            <a href="#">Mengatur Tampilan Warna Dominan</a>
                        </h3>
                        <p class="text-gray-600 text-sm mb-4 line-clamp-3 leading-relaxed">
                            Template ini menggunakan utilitas Tailwind CSS. Anda bisa mengganti kode class seperti 'bg-blue-600' menjadi warna lain dengan mudah.
                        </p>
                        <div class="mt-auto text-xs text-gray-400">5 September 2026</div>
                    </div>
                </article>
            </div>
        </section>

        <!-- CONTACT & FOOTER SIGNUP SECTION -->
        <section id="kontak" class="bg-gray-900 text-white py-16">
            <div class="max-w-4xl mx-auto px-4 text-center">
                <h2 class="text-3xl font-bold mb-4">Tertarik Menggunakan Template Ini?</h2>
                <p class="text-gray-400 max-w-xl mx-auto mb-8">
                    Hubungi kami atau daftarkan email Anda untuk mendapatkan pembaruan berkala langsung di kotak masuk Anda.
                </p>
                <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="event.preventDefault(); alert('Formulir berhasil dikirim (Contoh)!');">
                    <input type="email" placeholder="Masukkan alamat email Anda" required 
                        class="bg-gray-800 text-white placeholder-gray-500 px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 flex-grow border border-gray-700">
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-6 py-3 rounded-lg smooth-transition shadow-sm">
                        Berlangganan
                    </button>
                </form>
            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer class="bg-gray-950 text-gray-500 text-sm py-8 border-t border-gray-900">
        <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <p>&copy; 2026 NamaWebsite. Hak Cipta Dilindungi.</p>
            <div class="flex gap-6">
                <a href="#" class="hover:text-white smooth-transition">Kebijakan Privasi</a>
                <a href="#" class="hover:text-white smooth-transition">Syarat & Ketentuan</a>
            </div>
        </div>
    </footer>

<script>
  const header = document.getElementById('main-header');
  const gearBtn = document.getElementById('gear-menu-btn');
  const popupMenu = document.getElementById('popup-menu');
  const popupContent = document.getElementById('popup-content');
  const closeBtn = document.getElementById('close-menu-btn');

  // 1. Deteksi Scroll Halaman
  window.addEventListener('scroll', () => {
    if (window.scrollY > 150) { 
      // Sembunyikan header standar bawaan
      header.classList.add('-translate-y-full', 'pointer-events-none');
      header.classList.remove('sticky');
      // Munculkan tombol roda gigi di pojok kanan atas
      gearBtn.classList.remove('hidden');
    } else {
      // Munculkan kembali header standar saat kembali ke atas
      header.classList.remove('-translate-y-full', 'pointer-events-none');
      header.classList.add('sticky');
      // Sembunyikan tombol roda gigi
      gearBtn.classList.add('hidden');
      // Tutup pop-up jika masih terbuka
      closePopup();
    }
  });

  // 2. Fungsi Buka Pop-up
  gearBtn.addEventListener('click', () => {
    popupMenu.classList.remove('hidden');
    setTimeout(() => {
      popupContent.classList.remove('scale-95', 'opacity-0');
      popupContent.classList.add('scale-100', 'opacity-100');
    }, 10);
  });

  // 3. Fungsi Tutup Pop-up
  function closePopup() {
    popupContent.classList.remove('scale-100', 'opacity-100');
    popupContent.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      popupMenu.classList.add('hidden');
    }, 300);
  }

  closeBtn.addEventListener('click', closePopup);
  
  // Tutup jika area luar pop-up di-klik
  popupMenu.addEventListener('click', (e) => {
    if (e.target === popupMenu) closePopup();
  });
</script>

</body>
</html>
