<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tema Website Standar Mudah Diisi</title>
  <!-- Menggunakan Tailwind CSS CDN untuk kemudahan desain -->
  <script src="https://tailwindcss.com"></script>
  <style>
    /* CSS Khusus untuk animasi roda gigi berputar lambat secara konstan (20 detik per putaran) */
    .animate-spin-slow {
      animation: spin 20s linear infinite;
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">

  <!-- 1. HEADER & NAVIGASI UTAMA -->
  <header id="main-header" class="bg-white shadow-sm sticky top-0 z-50 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16 items-center">
        <!-- Logo / Nama Website -->
        <div class="flex-shrink-0 flex items-center">
          <span class="text-xl font-bold text-red-600 tracking-wide">NamaWebsite</span>
        </div>
        <!-- Menu Navigasi Layar Besar -->
        <nav id="standard-menu" class="hidden md:flex space-x-8">
          <a href="#" class="text-gray-600 hover:text-red-600 font-medium transition-colors">Beranda</a>
          <a href="#" class="text-gray-600 hover:text-red-600 font-medium transition-colors">Fitur</a>
          <a href="#" class="text-gray-600 hover:text-red-600 font-medium transition-colors">Blog</a>
          <a href="#" class="text-gray-600 hover:text-red-600 font-medium transition-colors">Kontak</a>
        </nav>
      </div>
    </div>
  </header>

  <!-- 2. TOMBOL RODA GIGI FLOATING (Muncul otomatis saat scroll ke bawah) -->
  <button id="gear-menu-btn" class="hidden fixed top-4 right-4 z-50 bg-red-600 hover:bg-red-700 text-white p-3 rounded-full shadow-lg transition-all duration-300 transform focus:outline-none">
    <!-- Icon SVG Roda Gigi Interaktif Berputar Lambat -->
    <svg xmlns="http://w3.org" class="h-6 w-6 animate-spin-slow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
  </button>

  <!-- 3. PANEL POP-UP MENU VERTIKAL (Disembunyikan dengan kelas 'hidden' secara default) -->
  <div id="popup-menu" class="hidden fixed inset-0 z-50 bg-gray-900 bg-opacity-50 flex justify-end items-start pt-16 pr-4 transition-opacity duration-300">
    <div id="popup-content" class="bg-white w-56 rounded-xl shadow-xl p-4 transform transition-all duration-300 ease-in-out scale-95 opacity-0 origin-top-right">
      <div class="flex justify-between items-center mb-4 border-b pb-2">
        <span class="font-bold text-gray-700">Navigasi</span>
        <button id="close-menu-btn" class="text-gray-400 hover:text-red-600 font-bold text-lg transition-colors focus:outline-none">✕</button>
      </div>
      <div class="flex flex-col space-y-3">
        <a href="#" class="text-gray-600 hover:text-red-600 py-1 border-b border-gray-50 transition-colors">Beranda</a>
        <a href="#" class="text-gray-600 hover:text-red-600 py-1 border-b border-gray-50 transition-colors">Fitur</a>
        <a href="#" class="text-gray-600 hover:text-red-600 py-1 border-b border-gray-50 transition-colors">Blog</a>
        <a href="#" class="text-gray-600 hover:text-red-600 py-1 transition-colors">Kontak</a>
      </div>
    </div>
  </div>

  <!-- 4. HERO SECTION (BANNER UTAMA GRADASI MERAH-MARUN ELEGAN) -->
